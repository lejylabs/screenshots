{
  "Version": "17.0.0",
  "Name": "Example",
  "DestinationType": "ImageUploader",
  "RequestMethod": "POST",
  "RequestURL": "https://example.invalid/upload",
  "Body": "MultipartFormData",
  "FileFormName": "file",
  "Headers": {
    "X-Client": "screenshots"
  },
  "Parameters": {
    "format": "json"
  },
  "Arguments": {
    "title": "screenshot"
  },
  "URL": "{json:url}"
}
