<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>screenshots-sxcu</AssemblyName><RootNamespace>Screenshots.ShareXRuntime</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion><SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed><PublishSingleFile>false</PublishSingleFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><NuGetAuditMode>all</NuGetAuditMode>
    <DebugType>none</DebugType><Deterministic>true</Deterministic><InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Newtonsoft.Json" Version="[13.0.4]"/></ItemGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="67108864"/>
    <RuntimeHostConfigurationOption Include="System.GC.Server" Value="false"/>
    <RuntimeHostConfigurationOption Include="System.GC.Concurrent" Value="false"/>
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation" Value="false"/>
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredPGO" Value="false"/>
  </ItemGroup>
</Project>
